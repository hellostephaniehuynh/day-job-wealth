# Copy this file to .env.local and fill in the values as you connect each
# service. The site works and looks complete with none of these set — each
# feature just shows a friendly "not connected yet" message until you add
# its keys.

# --- Sanity (blog CMS) ---------------------------------------------------
# Create a free project at https://www.sanity.io/manage, then visit
# /studio on this site to start writing posts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Stripe (paid digital products) --------------------------------------
# From https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create a Product + Price in Stripe for each paid guide, then paste the
# Price IDs (starting with "price_") here.
STRIPE_PRICE_HOME_ASSET_BLUEPRINT=
STRIPE_PRICE_HOME_INCOME_SNAPSHOT=

# --- ConvertKit (free guide opt-in) ---------------------------------------
# From https://app.convertkit.com/account_settings/advanced_settings (API key)
# and the form's settings page (Form ID is in the form's embed code / URL).
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Contact form email (optional) ----------------------------------------
# Without these, contact form submissions are logged on the server instead
# of emailed. From https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# --- Site ------------------------------------------------------------------
# Used to build absolute URLs for Stripe redirects. Set this to your real
# domain once deployed (e.g. https://dayjobwealth.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
